# ---------------------------------------------------------------------------
# yahadeen — Pharmacy attendant app (Expo SDK 57)
# ---------------------------------------------------------------------------
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle,
# which means anyone with the app can read them. Never put a service-role key,
# a payment secret, or any other credential in this file.
#
# Fill in the values below, then restart Metro with `pnpm dev:attendant`
# (env changes are read at bundle time, not at runtime).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe to ship: every query it makes is
# still filtered by row-level security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Next.js API (apps/admin-app). No trailing slash.
#   local, Android emulator ...... http://10.0.2.2:3000
#   local, iOS simulator ......... http://localhost:3000
#   Expo Go on a real device ..... http://<your-LAN-IP>:3000
#   production ................... https://admin.yahadeen.ng
EXPO_PUBLIC_API_URL=

# development | staging | production — gates debug banners and log verbosity.
EXPO_PUBLIC_ENV=development

# Expo Push Notifications (for production builds)
EXPO_PUBLIC_EXPO_PROJECT_ID=
