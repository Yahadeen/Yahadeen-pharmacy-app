{
  "expo": {
    "name": "yahadeen pharm go",
    "slug": "yahadeen-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yahadeen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#0036B6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yahadeen.customer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yahadeen.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "yahadeen",
              "host": "payment"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#070B18"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow yahadeen pharm go to use Face ID to keep you signed in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "yahadeen pharm go needs access to your photos so you can upload a prescription.",
          "cameraPermission": "yahadeen pharm go needs your camera so you can photograph a prescription."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0036B6",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "32382f78-5b52-4447-8ccf-a8b41a13aca0"
      },
      "router": {}
    },
    "owner": "yahadeens-team"
  }
}
