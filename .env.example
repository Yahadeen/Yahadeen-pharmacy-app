# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DB_URL=postgresql://user:password@host:port/database

# Cloudflare R2 Configuration
CLOUDFLARE_R2_API_URL=your-r2-api-url
CLOUDFLARE_R2_DEV_URL=your-r2-dev-url
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Paystack Configuration
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# JWT Configuration
JWT_KEY_ID=your-jwt-key-id
JWT_DISCOVERY_URL=your-jwt-discovery-url

# App Configuration
NEXT_PUBLIC_APP_NAME=Yahadeen
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Service Configuration
EMAIL_PROVIDER=zoho
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ORGANIZATION_ID=your-zoho-organization-id
ZOHO_FROM_EMAIL=noreply@yahadeen.ng
ZOHO_FROM_NAME=Yahadeen

# OneSignal Email (alternative)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key
ONESIGNAL_FROM_EMAIL=noreply@yahadeen.ng
ONESIGNAL_FROM_NAME=Yahadeen
ONESIGNAL_EMAIL_TEMPLATE_ID=your-onesignal-template-id

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token
EXPO_PROJECT_ID=your_expo_project_id

# Legacy SMTP (deprecated - use Zoho/OneSignal instead)
SMTP_FROM=noreply@yahadeen.com
